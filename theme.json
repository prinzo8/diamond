{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "palette": [
        { "slug": "ink", "color": "#0C0D0D", "name": "Tinta" },
        { "slug": "charcoal", "color": "#171A1A", "name": "Carbón" },
        { "slug": "petrol", "color": "#1E4C4D", "name": "Petróleo Tarraco" },
        { "slug": "ivory", "color": "#F1E9DA", "name": "Marfil" },
        { "slug": "patina", "color": "#B29A5E", "name": "Pátina" },
        { "slug": "wine", "color": "#662A2A", "name": "Burdeos" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "fontFamily": "Manrope, sans-serif", "slug": "manrope", "name": "Manrope" },
        { "fontFamily": "'Bebas Neue', sans-serif", "slug": "bebas-neue", "name": "Bebas Neue" }
      ]
    },
    "layout": { "contentSize": "720px", "wideSize": "1280px" }
  },
  "styles": {
    "color": { "background": "#0C0D0D", "text": "#F1E9DA" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--manrope)" }
  }
}

